# FinPilot Week 2 — environment template. Copy to .env and fill in real values.
# WHY: secrets and environment-specific values never live in code or in git.
# The same code runs in dev and prod — only this file's values differ.

# ── Django ──
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Logging ──
# DJANGO_LOG_LEVEL: DEBUG for detailed step-by-step runtime traces, else INFO.
# DJANGO_SQL_LOG:   True to log every SQL query (very noisy — debugging only).
DJANGO_LOG_LEVEL=INFO
DJANGO_SQL_LOG=False

# ── Database ──
# Leave DATABASE_URL empty to use SQLite (dev default). For PostgreSQL:
#   DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=

# ── Celery / Redis ──
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── CORS (origin of the Week 4 dashboard) ──
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ── Week 3 LLM layer ──
GEMINI_API_KEY=
# Model override — default is gemini-flash-latest (free-tier quotas move;
# gemini-2.0-flash went to limit:0 in 2026). Pin only if a version matters.
GEMINI_MODEL=
NEWS_API_KEY=

# ── TLS behind antivirus HTTPS scanning (Avast/AVG) ──
# If Python HTTPS fails with "unable to get local issuer certificate" while
# the browser works fine, an AV product is re-signing TLS. Build a combined
# CA bundle (certifi + the AV root from the Windows store) and point these
# at it:   python scripts/build_ca_bundle.py
CURL_CA_BUNDLE=
SSL_CERT_FILE=
REQUESTS_CA_BUNDLE=

# ── Week 4 broker ──
# BROKER selects which broker the daily order task uses:
#   paper  — simulated money, the safe default (no exchange, no real risk).
#   kite   — live Zerodha Kite Connect. Real orders, real money.
# Promote to "kite" only after the paper run has convinced you, and start small.
BROKER=paper

# Risk gates enforced by OrderManager (see week4/broker/order_manager.py).
BROKER_MAX_TRADE_VALUE=50000
BROKER_MAX_POSITIONS=10
BROKER_MAX_DAILY_ORDERS=20

# PaperBroker only — starting cash for the simulated account.
PAPER_STARTING_CASH=1000000

# LLM analyst gate (week3): "auto" = review trades when GEMINI_API_KEY is set;
# "off" = never call the analyst. The gate can veto or halve a proposed trade;
# it fails open, so an LLM outage never blocks the deterministic pipeline.
ANALYST_GATE=auto

# Zerodha Kite Connect — required when BROKER=kite.
#   1. Register an app at https://developers.kite.trade — you get API_KEY + SECRET.
#   2. Run `python week4/scripts/kite_login.py` once per trading day.
#   3. Paste the printed access token below.
#   The token expires the next morning (Zerodha's security policy — unavoidable).
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
